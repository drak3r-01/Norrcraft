+
+def blossom(img, cx, cy, petal, center, r=2):
+    for dx in range(-r, r + 1):
+        for dy in range(-r, r + 1):
+            if abs(dx) + abs(dy) <= r + (1 if r > 1 else 0) - (1 if abs(dx) == abs(dy) == r else 0):
+                put(img, [(cx + dx, cy + dy)], petal)
+    put(img, [(cx, cy)], center)
+
+
+def make_sprites():
